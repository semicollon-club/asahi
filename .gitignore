# 의존성 / 빌드 산출물
node_modules/
dist/

# 비밀값 (.env 는 어느 폴더에 있든 무시)
.env

# 런타임 데이터 (SQLite DB + 개인 기억) — 절대 커밋하지 않음
data/

# 로그
*.log

# 미니PC 자동 갱신 센티넬 — 업데이터(deploy/update-worker.ps1)가 리포 루트에 만들었다
# 지우는 신호 파일. C:\ 루트에 못 두는 이유는 worker-셋업.md "자동 갱신" 절 참고.
update.flag

# 런타임 stdout 스냅샷·임시 메모(server.txt, localworker.txt 등) — 실수 커밋 방지
*.txt

# 스킬 폴더는 위 확장자·디렉터리 기반 규칙(*.txt·data/·*.log 등)의 예외로 되살린다 — 이
# 하네스의 계약은 외부 스킬을 agent/skill-plugin/ 밑에 폴더째 그대로 복사해 커밋하는 것인데,
# 확장자로 거르면 스킬이 흔히 동봉하는 LICENSE.txt·references/·assets/·data/ 가 경고 한 줄
# 없이 조용히 빠진다. 디렉터리 무시(예: data/)는 git 이 그 안으로 내려가는 것 자체를 막으므로,
# 디렉터리 재포함(첫 줄)이 파일 재포함(둘째 줄)보다 먼저 와야 한다 — 순서를 바꾸면 둘째 줄은
# 아무 효과가 없다.
!agent/skill-plugin/**/
!agent/skill-plugin/**
