# 디스코드 봇 토큰 (Discord Developer Portal > Bot)
DISCORD_TOKEN=
# 소유자(본인)의 디스코드 사용자 ID — 이 사람의 메시지에만 반응
DISCORD_OWNER_ID=
# Postgres(Supabase) 연결 문자열 — 필수
DATABASE_URL=
# (선택, 현재 미사용) DM 외에 반응할 서버 채널 ID
DISCORD_CHANNEL_ID=
# (선택) claude setup-token 으로 발급한 구독 OAuth 토큰 — cloud(DEPLOY_TARGET=cloud)에선 사실상 필수, 없으면 SDK 인증 실패
CLAUDE_CODE_OAUTH_TOKEN=
# (선택) 세션 유휴 종료 시간(분), 기본 30
SESSION_IDLE_MINUTES=
# (선택) 시간당 최대 턴 수(구독 한도 보호), 기본 30 — 하위호환용
MAX_TURNS_PER_HOUR=
# (선택) 멀티유저 한도 — 유저별 시간당 상한, 기본 20
MAX_TURNS_PER_HOUR_PER_USER=
# (선택) 멀티유저 한도 — 전역 시간당 상한, 기본 40
MAX_TURNS_PER_HOUR_GLOBAL=
# (선택, 현재 미사용) 소유자는 무제한 정책이라 예약분이 필요 없음 — 하위호환 위해 남겨둠
OWNER_RESERVE=
# (선택) 런타임 데이터 경로 재정의 — 기본값은 리포 루트의 data/store, data/memory
DATA_DIR=
MEMORY_DIR=
# (선택) 배포 대상: local 또는 cloud, 기본 local — cloud 면 소유자 DM 이라도 PC 파일/Bash 도구를 비활성한다
DEPLOY_TARGET=
# (선택) 사용할 Claude 모델, 기본 claude-opus-4-8 (config.ts)
ANTHROPIC_MODEL=

# ── 정기 뉴스 게시 ──
# 매일 KST 7시에 조사 결과를 올릴 채널. 설정하지 않은 주제는 스케줄에서 건너뛴다
# (예약어 /대회·/개발뉴스 로는 어느 채널에서든 실행할 수 있다).
DIGEST_CONTEST_CHANNEL_ID=
DIGEST_DEVNEWS_CHANNEL_ID=

# 워커 허브(봇) — 워커가 붙을 포트. Railway 가 PORT 를 주입하므로 보통 비워둔다.
PORT=3000
# 워커 인증은 이제 봇의 공유 비밀이 아니라 workers 테이블(레지스트리)에서 이뤄진다 — 워커별로
# npx tsx src/scripts/registerWorker.ts 가 발급한 해시 토큰을 허브가 접속마다 조회해 확인한다. 그래서 봇 쪽
# .env 에는 더 이상 토큰이 없다(새 워커 등록·토큰 재발급은 아래 WORKER_ID/WORKER_TOKEN 설명 참고).

# ── 로컬 워커 전용 ──
# 허브 WebSocket 주소. Railway 도메인 뒤에 /worker 를 붙인다.
HUB_URL=wss://<your-app>.up.railway.app/worker
# 이 워커의 식별자와 인증 토큰. 사람이 정하지 않는다 — 허브(봇)가 있는 쪽에서
#   cd agent && npx tsx src/scripts/registerWorker.ts --id <이름> --kind personal --user <디스코드 id>
# (공용 워커는 --kind shared 로, --user 는 생략)를 실행하면 이 두 값이 콘솔에 한 번만 출력된다.
# WORKER_TOKEN 은 재발급 전까지 다시 볼 수 없으니 그대로 옮겨 적는다.
# 경고: WORKER_TOKEN 이 곧 "이 워커" 라는 신원 증명이다 — 새어나가면 그 문자열을 아는 사람 누구나
# 이 워커인 척 허브에 접속해, 그 뒤 보내는 fs_write 내용·sh_exec 명령을 전부 가로채고 임의의
# 결과를 대신 돌려줄 수 있다(허브는 응답을 그 접속을 보낸 쪽의 것으로 그대로 믿는다).
# .env 파일을 절대 커밋하거나 공유하지 않는다.
WORKER_ID=
WORKER_TOKEN=
# 이 워커가 노출할 폴더(쉼표 구분, 절대경로). fs_read/fs_write/fs_edit/fs_glob/fs_grep 는 이
# 목록 밖의 경로를 전부 거부한다. 단, sh_exec(셸 명령 실행)는 예외다 — 셸은 경로 인자 하나로
# 판정할 수 있는 대상이 아니라서 이 목록으로 봉쇄되지 않는다. sh_exec 의 유일한 경계는 실행 시
# cwd(이 목록의 첫 번째 폴더)와 이 프로세스를 돌리는 OS 계정의 권한뿐이다 — 그 계정이 닿는
# 곳이라면 셸 명령은 WORKER_ROOTS 밖도 오갈 수 있다는 뜻이다.
WORKER_ROOTS=
# (선택) 이 경로에 파일이 생기면 워커가 진행 중인 호출을 마치고 스스로 종료한다 — 미니PC
# 자동 갱신(deploy/update-worker.ps1)이 갱신 신호로 쓰는 센티넬이다. 비워두면 감시 자체를
# 하지 않는다(옵트인 — 자동 갱신을 쓰지 않는 개인 PC 워커까지 이 로직을 태울 이유가 없다).
# 미니PC 표준 구성은 C:\asahi-worker\update.flag — 업데이터 스크립트의 -Sentinel 기본값과
# 같아야 한다. WORKER_ROOTS 밖이되 C:\ 루트는 안 된다: 표준 계정은 C:\ 루트에 파일을 만들
# 수 없다(폴더는 되고 파일은 안 되는 윈도우 기본 ACL — 2026-08-01 첫 실전 갱신이 이걸로
# 막혔다). 방어선이 아니라 실수 방지선이다 — sh_exec 는 경로로 봉쇄되지 않으므로 어차피
# 새 능력은 아니다. deploy/worker-셋업.md "자동 갱신" 절 참고.
WORKER_SENTINEL=
