# 디스코드 봇 토큰 (Discord Developer Portal > Bot)
DISCORD_TOKEN=
# 소유자(본인)의 디스코드 사용자 ID — 이 사람의 메시지에만 반응
DISCORD_OWNER_ID=
# Postgres(Supabase) 연결 문자열 — 필수
DATABASE_URL=
# (선택) DM 외에 반응할 서버 채널 ID
DISCORD_CHANNEL_ID=
# (선택) claude setup-token 으로 발급한 구독 OAuth 토큰 — cloud(DEPLOY_TARGET=cloud)에선 사실상 필수, 없으면 SDK 인증 실패
CLAUDE_CODE_OAUTH_TOKEN=
# (선택) 세션 유휴 종료 시간(분), 기본 30
SESSION_IDLE_MINUTES=
# (선택) 시간당 최대 턴 수(구독 한도 보호), 기본 30 — 하위호환용
MAX_TURNS_PER_HOUR=
# (선택) 멀티유저 한도 — 유저별 시간당 상한, 기본 20
MAX_TURNS_PER_HOUR_PER_USER=
# (선택) 멀티유저 한도 — 전역 시간당 상한, 기본 40
MAX_TURNS_PER_HOUR_GLOBAL=
# (선택, 현재 미사용) 소유자는 무제한 정책이라 예약분이 필요 없음 — 하위호환 위해 남겨둠
OWNER_RESERVE=
# (선택) 런타임 데이터 경로 재정의 — 기본값은 리포 루트의 data/store, data/memory
DATA_DIR=
MEMORY_DIR=
# (선택) 배포 대상: local 또는 cloud, 기본 local — cloud 면 소유자 DM 이라도 PC 파일/Bash 도구를 비활성한다
DEPLOY_TARGET=
# (선택) 사용할 Claude 모델, 기본 claude-opus-4-8 (config.ts)
ANTHROPIC_MODEL=
# 워커 허브(봇) — 워커가 붙을 포트. Railway 가 PORT 를 주입하므로 보통 비워둔다.
PORT=3000
# 워커 인증 토큰 — 필수. 비어 있거나 너무 짧으면(최소 20자) 봇이 아예 시작하지 않는다. 아무
# 문자열이 아니라 반드시 "긴 무작위" 문자열이어야 한다(예: openssl rand -hex 32). 봇과 워커
# 양쪽에 정확히 같은 값을 넣는다.
# 경고: 이 값 자체가 "소유자의 워커" 라는 신원 증명이다 — 새어나가면 그 문자열을 아는 사람 누구나
# 워커인 척 허브에 접속해, 소유자가 그 뒤 보내는 fs_write 내용·sh_exec 명령을 전부 가로채고
# 임의의 결과를 대신 돌려줄 수 있다(허브는 응답을 그 접속을 보낸 쪽의 것으로 그대로 믿는다).
# .env 파일을 절대 커밋하거나 공유하지 않는다.
WORKER_TOKEN=

# ── 로컬 워커 전용 ──
# 허브 WebSocket 주소. Railway 도메인 뒤에 /worker 를 붙인다.
HUB_URL=wss://<your-app>.up.railway.app/worker
# 이 워커가 담당할 디스코드 사용자 ID(1단계는 소유자 본인)
WORKER_USER_ID=
# 이 워커가 노출할 폴더(쉼표 구분, 절대경로). fs_read/fs_write/fs_edit/fs_glob/fs_grep 는 이
# 목록 밖의 경로를 전부 거부한다. 단, sh_exec(셸 명령 실행)는 예외다 — 셸은 경로 인자 하나로
# 판정할 수 있는 대상이 아니라서 이 목록으로 봉쇄되지 않는다. sh_exec 의 유일한 경계는 실행 시
# cwd(이 목록의 첫 번째 폴더)와 이 프로세스를 돌리는 OS 계정의 권한뿐이다 — 그 계정이 닿는
# 곳이라면 셸 명령은 WORKER_ROOTS 밖도 오갈 수 있다는 뜻이다.
WORKER_ROOTS=

# ── 표정 이미지 동기화(scripts/sync-images.mjs) 전용 ──
# Supabase 프로젝트 URL. 예: https://xxxxx.supabase.co
SUPABASE_URL=
# Supabase service_role 키. Storage 업로드 권한이 필요하다. 절대 공개하지 않는다.
SUPABASE_SERVICE_KEY=
