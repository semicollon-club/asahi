# web-api 로컬 실행용 환경변수. Railway에서는 PORT를 자동 주입한다.
PORT=8788

# 로컬 개발은 dev DB(semicollon-dev)를 쓴다. 접속 문자열은 운영자/팀 채널에서 받기.
# 형식: postgresql://web_api.<프로젝트ref>:<비밀번호>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=

# 마이그레이션 적용용(web_migrator role, dev DB). npm run migrate:dev 가 사용한다.
MIGRATE_DATABASE_URL=

# 쿠키 포함 요청을 허용할 프론트 origin (콤마 구분). 생략 시 http://localhost:5173
WEB_ORIGINS=http://localhost:5173
